EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_your_public_sdk_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_public_sdk_key_here
# Only needed if you enable RevenueCat Web Billing:
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=web_your_public_sdk_key_here
# RevenueCat Test Store key (starts with test_). Used only in debug/development builds; production builds ignore it.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
